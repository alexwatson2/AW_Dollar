<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical"
    android:layoutDirection="ltr" android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/fiat_row"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal">
        <LinearLayout android:id="@+id/usd_row"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center_vertical" android:contentDescription="@string/dollar_history">
            <ImageView android:layout_width="14dp" android:layout_height="14dp"
                android:src="@drawable/usd_flag" android:scaleType="fitCenter"
                android:importantForAccessibility="no" android:contentDescription="@null" />
            <TextView android:id="@+id/usd_price"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginStart="2dp" android:gravity="start|center_vertical"
                android:text="—" android:textSize="11sp" android:textStyle="bold"
                android:fontFamily="sans-serif" android:textColor="#FFFFFF"
                android:includeFontPadding="false" android:maxLines="1" android:textDirection="ltr"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/usd_trend"
                android:layout_width="8dp" android:layout_height="match_parent"
                android:gravity="center" android:text="—" android:maxLines="1" android:textColor="#B7BDC4"
                android:textSize="8sp" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:id="@+id/eur_row"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center_vertical" android:contentDescription="@string/euro_history">
            <ImageView android:layout_width="14dp" android:layout_height="14dp"
                android:src="@drawable/eur_flag" android:scaleType="fitCenter"
                android:importantForAccessibility="no" android:contentDescription="@null" />
            <TextView android:id="@+id/eur_price"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginStart="2dp" android:gravity="start|center_vertical"
                android:text="—" android:textSize="11sp" android:textStyle="bold"
                android:fontFamily="sans-serif" android:textColor="#FFFFFF"
                android:includeFontPadding="false" android:maxLines="1" android:textDirection="ltr"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/eur_trend"
                android:layout_width="8dp" android:layout_height="match_parent"
                android:gravity="center" android:text="—" android:maxLines="1" android:textColor="#B7BDC4"
                android:textSize="8sp" android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/crypto_row"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal">
        <LinearLayout android:id="@+id/usdt_row"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center_vertical" android:contentDescription="@string/usdt_history">
            <ImageView android:layout_width="14dp" android:layout_height="14dp"
                android:src="@drawable/usdt_icon" android:scaleType="fitCenter"
                android:importantForAccessibility="no" android:contentDescription="@null" />
            <TextView android:id="@+id/usdt_price"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginStart="2dp" android:gravity="start|center_vertical"
                android:text="—" android:textSize="11sp" android:textStyle="bold"
                android:fontFamily="sans-serif" android:textColor="#FFFFFF"
                android:includeFontPadding="false" android:maxLines="1" android:textDirection="ltr"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/usdt_trend"
                android:layout_width="8dp" android:layout_height="match_parent"
                android:gravity="center" android:text="—" android:maxLines="1" android:textColor="#B7BDC4"
                android:textSize="8sp" android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout android:id="@+id/btc_row"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center_vertical" android:contentDescription="@string/btc_history">
            <ImageView android:layout_width="14dp" android:layout_height="14dp"
                android:src="@drawable/btc_icon" android:scaleType="fitCenter"
                android:importantForAccessibility="no" android:contentDescription="@null" />
            <TextView android:id="@+id/btc_price"
                android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginStart="2dp" android:gravity="start|center_vertical"
                android:text="—" android:textSize="11sp" android:textStyle="bold"
                android:fontFamily="sans-serif" android:textColor="#FFFFFF"
                android:includeFontPadding="false" android:maxLines="1" android:textDirection="ltr"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/btc_trend"
                android:layout_width="8dp" android:layout_height="match_parent"
                android:gravity="center" android:text="—" android:maxLines="1" android:textColor="#B7BDC4"
                android:textSize="8sp" android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/updated"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:layout_marginTop="1dp"
        android:text="—" android:textSize="9sp" android:textColor="#B7BDC4"
        android:includeFontPadding="false" android:maxLines="1" android:textDirection="ltr"
        android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp"
        android:autoSizeMaxTextSize="9sp" android:autoSizeStepGranularity="1sp" />
</LinearLayout>
