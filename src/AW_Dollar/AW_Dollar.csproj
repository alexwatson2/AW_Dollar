<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\app_icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AW_Dollar</AssemblyName>
    <RootNamespace>AW_Dollar</RootNamespace>
    <!-- No window is ever shown; this keeps the taskbar free of a console/app window. -->
    <StartupObject>AW_Dollar.Program</StartupObject>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>1.0.0</Version>
    <Product>AW Dollar</Product>
    <Company>AW Dollar</Company>
    <Description>نمایش لحظه‌ای نرخ دلار و یورو (بازار آزاد) در Tray ویندوز</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\dollar_base.png" />
    <EmbeddedResource Include="Resources\euro_base.png" />
  </ItemGroup>

</Project>
